# Application
SECRET_KEY=your-secret-key-here
DEBUG=True
# false = no public signup (default). Set true briefly to register the first user, then promote to super_admin in DB.
ALLOW_PUBLIC_REGISTRATION=false

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Microsoft Outlook (Graph API) — optional
# MICROSOFT_CLIENT_ID=your-azure-app-client-id
# MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
# MICROSOFT_TENANT_ID=common
# MICROSOFT_GRAPH_SCOPES=https://graph.microsoft.com/Calendars.ReadWrite offline_access

# Apple iCloud CalDAV — optional (users connect with app-specific password)
# CALDAV_SERVER_URL=https://caldav.icloud.com

# OpenAI (chat + default/fallback voice STT/TTS)
OPENAI_API_KEY=

# ElevenLabs (optional; used for basic/premium voice when set — see docs/VOICE.md)
# ELEVENLABS_API_KEY=
# ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_PREMIUM_VOICE_IDS=  # comma-separated extra voice IDs for premium
# ELEVENLABS_STT_MODEL_ID=scribe_v1
# ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2

# Dashboard TTS preview (POST /api/businesses/{id}/voice/preview) — requests per user per business per minute
# VOICE_PREVIEW_RATE_PER_MINUTE=30

# Database — PostgreSQL only (users, logins, businesses, appointments, etc.)
# Use postgresql+psycopg:// when using psycopg (v3) for Python 3.13
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_support_db

# Celery (background calendar sync) — optional; requires Redis
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Twilio (voice calls) — optional; for Phase 3 voice (see docs/VOICE.md)
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890
# VOICE_WEBHOOK_BASE_URL=https://your-public-api.example.com

# Voice call state + TTS token cache across workers (optional but recommended in production)
# REDIS_URL=redis://localhost:6379/0
